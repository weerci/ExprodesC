<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ExprodesC.AppearanceView"
			 
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
			 xmlns:lang="using:ExprodesC.Lang"
			 RenderOptions.BitmapInterpolationMode="HighQuality"
			 
			 >

	<ui:SettingsExpander Header="{x:Static lang:Resources.set_theme}"
						 IconSource="DarkTheme"
						 Description="{x:Static lang:Resources.set_theme_desc}">
		<ui:SettingsExpander.Footer>
			<ComboBox x:Name="cbTheme">
			</ComboBox>
		</ui:SettingsExpander.Footer>
	</ui:SettingsExpander>
</UserControl>

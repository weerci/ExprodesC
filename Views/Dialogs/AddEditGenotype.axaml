<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 RenderOptions.BitmapInterpolationMode="HighQuality"
             x:Class="ExprodesC.AddEditGenotype"
			 Loaded="UserControl_Loaded"
			 
			 xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:lang="using:ExprodesC.Lang"
			 xmlns:vm="using:ExprodesC.Views.Dialogs"
			 x:DataType="vm:AddEditGenotypeVM"
			 x:Name="ucAddEditGenotype"
			 
			 
			 >
	<Design.DataContext>
		<vm:AddEditGenotypeVM/>
	</Design.DataContext>

	<Grid RowDefinitions="40 *">
		<DockPanel Margin="10">
			<TextBlock  Text="{x:Static lang:Resources.cap_name}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
			<TextBox x:Name="tbName" Margin="15 0 0 0" VerticalAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
		</DockPanel>
		<Grid ColumnDefinitions="* 5 130 130" Grid.Row="1" Margin="0 10">
			<DockPanel>
				<TextBlock Text="Выбранные локусы" HorizontalAlignment="Center" DockPanel.Dock="Top"/>

				<!-- Выбранные локусы -->
				<ListBox x:Name="lbSelected" ItemsSource="{Binding ListSelected}" SelectedItem="{Binding SelectedGenome}" >
					<ItemsControl.ItemTemplate>
						<DataTemplate>

							<Grid ColumnDefinitions="100 2 *">

								<!-- Locus Header -->
								<StackPanel Orientation="Horizontal">
									<CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding Genome.Locus.Name}" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>


								<GridSplitter Grid.Column="1" Background="Transparent"  ResizeDirection="Columns"/>
								<Rectangle Grid.Column="1" Fill="{DynamicResource ButtonBorderBrush}"
										   Width="1" IsHitTestVisible="False" VerticalAlignment="Stretch" />
								<material:MaterialIcon Width="25" Height="25" Grid.Column="1" Kind="UnfoldMoreVertical"
											   Foreground="{DynamicResource ButtonBorderBrush}" />

								<!-- Alleles WrapPanel -->
								<ItemsControl ItemsSource="{Binding Lvms}" Grid.Column="2" VerticalAlignment="Center" Margin="25 0 0 0">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Viewbox Height="24">
												<CheckBox IsChecked="{Binding IsChecked}" Content="{Binding LocusAllele.AName}"/>
											</Viewbox>
										</DataTemplate>
									</ItemsControl.ItemTemplate>

								</ItemsControl>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ListBox>

			</DockPanel>

			<GridSplitter Grid.Column="1" Background="Transparent"  ResizeDirection="Columns"/>
			<Rectangle Grid.Column="1" Fill="{DynamicResource ButtonBorderBrush}"
					   Width="1" IsHitTestVisible="False" VerticalAlignment="Stretch" />
			<material:MaterialIcon Width="25" Height="25" Grid.Column="1" Kind="UnfoldMoreVertical"
						   Foreground="{DynamicResource ButtonBorderBrush}" />

			<DockPanel Grid.Column="2">
				<TextBlock Text="Локусы" HorizontalAlignment="Center" DockPanel.Dock="Top"/>

				<!--Все локусы-->
				<ListBox ItemsSource="{Binding ListAvailable}" SelectedItem="{Binding SelectedLocus, Mode=TwoWay}" />

			</DockPanel>

			<DockPanel Grid.Column="3" >
				<TextBlock Text="Аллели" HorizontalAlignment="Center" DockPanel.Dock="Top"/>

				<!--Список аллелей-->
				<ListBox ItemsSource="{Binding ListAlleles}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding LocusAllele.AName}" VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

			</DockPanel>
		</Grid>

		<ContentControl x:Name="ccGenotype" Content="{Binding GenotypeWR}" IsVisible="False"/>
	</Grid>
</UserControl>

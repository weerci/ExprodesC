<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<PublishTrimmed>true</PublishTrimmed>
		<PublishReadyToRun>true</PublishReadyToRun>
		<ApplicationIcon>Assets\DNA.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaXaml Remove="ExprodesCTest\**" />
		<AvaloniaXaml Remove="Extensions\**" />
		<AvaloniaXaml Remove="release\**" />
		<AvaloniaXaml Remove="Reports\**" />
		<AvaloniaXaml Remove="ViewModels\Dialogs\**" />
		<Compile Remove="ExprodesCTest\**" />
		<Compile Remove="Extensions\**" />
		<Compile Remove="release\**" />
		<Compile Remove="Reports\**" />
		<Compile Remove="ViewModels\Dialogs\**" />
		<EmbeddedResource Remove="ExprodesCTest\**" />
		<EmbeddedResource Remove="Extensions\**" />
		<EmbeddedResource Remove="release\**" />
		<EmbeddedResource Remove="Reports\**" />
		<EmbeddedResource Remove="ViewModels\Dialogs\**" />
		<None Remove="ExprodesCTest\**" />
		<None Remove="Extensions\**" />
		<None Remove="release\**" />
		<None Remove="Reports\**" />
		<None Remove="ViewModels\Dialogs\**" />
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaXaml Remove="Assets\Styles\Buttons.axaml" />
	  <AvaloniaXaml Remove="Assets\Styles\CommandBar.axaml" />
	  <AvaloniaXaml Remove="Assets\Styles\DataGrid.axaml" />
	  <AvaloniaXaml Remove="Assets\Styles\Flyout.axaml" />
	  <AvaloniaXaml Remove="Assets\Styles\InfoBar.axaml" />
	  <AvaloniaXaml Remove="Assets\Styles\LibraryPage.axaml" />
	  <AvaloniaXaml Remove="Assets\Styles\ToggleRadioButton.axaml" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Assets\DNA.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Include="Avalonia" Version="11.3.2" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
		<PackageReference Include="Avalonia.ReactiveUI" Version="11.3.2" />
		<PackageReference Include="FluentAvaloniaUI" Version="2.4.0-preview1" />
		<PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0-preview.3.25171.5" />
		<PackageReference Include="Moq" Version="4.18.2" />
		<PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
		<PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
		<PackageReference Include="System.Data.SQLite" Version="1.0.119" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.0-preview.3.25173.2" />
		<PackageReference Include="System.IO.Abstractions" Version="22.0.14" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Lang\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Settings\AppearanceView.axaml.cs">
	    <DependentUpon>AppearanceView.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Lang\Resources.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Lang\Resources.ru-RU.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="ExprodesCTest" />
	</ItemGroup>
	
	<ItemGroup>
	  <None Update="key">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	
	<ItemGroup>
	  <Reference Include="Calc">
	    <HintPath>..\Calc\Calc\bin\Release\net8.0\Calc.dll</HintPath>
	  </Reference>
	  <Reference Include="Func">
	    <HintPath>..\..\Func\bin\Release\net8.0\Func.dll</HintPath>
	  </Reference>
	</ItemGroup>
	
	<ItemGroup>
	  <AvaloniaResource Update="Assets\Styles\Buttons.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Assets\Styles\CommandBar.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Assets\Styles\DataGrid.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Assets\Styles\Flyout.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Assets\Styles\InfoBar.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Assets\Styles\LibraryPage.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Assets\Styles\ToggleRadioButton.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	</ItemGroup>
	
</Project>

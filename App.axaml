<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:ctrl="using:ExprodesC.Views.Controls"
             x:Class="ExprodesC.App"
             >
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
  
    <Application.Styles>
		<styling:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="True" />
		<StyleInclude Source="avares://Xaml.Behaviors.Interactions.Draggable/Styles.axaml" />
		<StyleInclude Source="avares://ExprodesC/Assets/Styles/ListBoxNoHilight.axaml" />
		<avalonia:MaterialIconStyles />
	</Application.Styles>

</Application>